{
  "name": "ui-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/explorer/catalog.test.ts server/jev.test.ts",
    "check": "npm run typecheck && npm test && vite build && npm run build:server",
    "screenshots": "node scripts/screenshots.mjs",
    "bundle": "node scripts/bundle-report.mjs",
    "test:previews": "node --import tsx scripts/check-previews.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.mjs",
    "start:server": "node dist-server/index.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mui/material": "9.4.0",
    "antd": "6.6.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@chakra-ui/react": "3.37.0",
    "@radix-ui/themes": "3.3.0",
    "@fluentui/react-components": "9.74.9",
    "@carbon/react": "1.117.0",
    "react-aria-components": "1.21.1",
    "@internationalized/date": "3.12.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.47",
    "sass": "1.105.1",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BryanZaneee/ui-viewer.git"
  },
  "homepage": "https://bryanzane.com/ui-viewer/"
}

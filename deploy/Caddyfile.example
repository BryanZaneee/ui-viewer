# Add inside the existing site block. The catalog is static; only semantic search uses Node.
redir /ui-viewer /ui-viewer/ permanent
handle_path /ui-viewer/* {
    handle /api/* {
        reverse_proxy 127.0.0.1:8040 {
            header_up X-UI-Viewer-IP {client_ip}
        }
    }
    handle {
    root * /var/www/ui-viewer/current/www
    @ui_viewer_pages not path /assets/*
    header @ui_viewer_pages >Cache-Control "no-store"
    header @ui_viewer_pages >CDN-Cache-Control "no-store"
    @ui_viewer_assets path /assets/*
    header @ui_viewer_assets >Cache-Control "public, max-age=31536000, immutable"
    @ui_viewer_preview path /preview.html
    header @ui_viewer_preview >X-Frame-Options "SAMEORIGIN"
    header @ui_viewer_preview >Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-ancestors 'self';"
    file_server
    }
}
